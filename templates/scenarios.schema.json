{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acceptance criteria and verification",
  "description": "Each acceptance criterion is one public verification record. Private results use results.schema.json.",
  "type": "object",
  "x-applicationChecks": [
    "SCN-1 Reject duplicate criterion IDs, duplicate scenario IDs, and ID collisions with checklist tasks.",
    "SCN-2 Require at least one complete criterion before publishing. Split distinct scenarios into separate criteria.",
    "SCN-3 State requirements in expectedResult and verification steps in actions. Prefix steps by surface when needed. Split cases with materially different starting states or procedures.",
    "SCN-4 Resolve runtime aliases in approved restricted storage.",
    "SCN-5 Review every shared definition for private identifiers or runtime details.",
    "SCN-6 Increase scenario version when a change affects what the check proves. Carry forward IDs and versions for structure-only migrations."
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[A-Za-z0-9.]+$"
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._][a-z0-9]+)*$",
      "maxLength": 40
    },
    "publicText": {
      "not": {
        "pattern": "://|\\bwww\\.|[^\\s@]+@[^\\s@]+\\.[A-Za-z]"
      }
    },
    "words19": {
      "type": "string",
      "pattern": "^\\S+(\\s+\\S+){0,18}$",
      "x-maxWords": 19,
      "allOf": [
        {
          "$ref": "#/$defs/publicText"
        }
      ]
    },
    "words30": {
      "type": "string",
      "pattern": "^\\S+(\\s+\\S+){0,29}$",
      "x-maxWords": 30,
      "allOf": [
        {
          "$ref": "#/$defs/publicText"
        }
      ]
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desktopUi",
        "mobileUi",
        "backend"
      ],
      "properties": {
        "desktopUi": {
          "type": "boolean"
        },
        "mobileUi": {
          "type": "boolean"
        },
        "backend": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "properties": {
            "desktopUi": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "mobileUi": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "backend": {
              "const": true
            }
          }
        }
      ]
    },
    "criterionText": {
      "type": "string",
      "pattern": "\\S",
      "allOf": [
        {
          "$ref": "#/$defs/publicText"
        }
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "startingState",
        "actions",
        "expectedResult",
        "scenarioId",
        "version",
        "actor",
        "surfaces"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/words19"
        },
        "scenarioId": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "$ref": "#/$defs/alias"
        },
        "environment": {
          "$ref": "#/$defs/alias"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterionText"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "surfaces": {
          "$ref": "#/$defs/surfaces"
        },
        "startingState": {
          "$ref": "#/$defs/criterionText"
        },
        "expectedResult": {
          "$ref": "#/$defs/criterionText"
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "criteria"
  ],
  "properties": {
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    }
  }
}
