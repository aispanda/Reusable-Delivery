{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story agent roster",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "leadId",
    "agents"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "leadId": {
      "type": "string",
      "pattern": "^(?:AI-[0-9]{2,}|[a-z][a-z0-9]*(?:[._][a-z0-9]+)*)$",
      "maxLength": 40,
      "not": {
        "pattern": "\\s"
      }
    },
    "sharedGuardrails": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role",
          "instructions",
          "authority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:AI-[0-9]{2,}|[a-z][a-z0-9]*(?:[._][a-z0-9]+)*)$",
            "maxLength": 40,
            "not": {
              "pattern": "\\s"
            }
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "authority": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "guardrails": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "tools": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform"
            ],
            "properties": {
              "platform": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reasoning": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "environment": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "location"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "location": {
                  "type": "string",
                  "pattern": "^(https://[^\\s]+|(?:\\./|\\.\\./)*[A-Za-z0-9_][^:\\s?#]*(?:#[^\\s]+)?)$"
                }
              }
            }
          }
        }
      }
    }
  }
}
